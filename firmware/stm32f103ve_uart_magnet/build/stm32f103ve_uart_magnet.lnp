--cpu Cortex-M3
".\build\main.o"
".\build\magnet_control.o"
".\build\system_stm32f10x.o"
".\build\startup_stm32f10x_hd.o"
--library_type=microlib --strict --scatter ".\firmware.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list ".\build\stm32f103ve_uart_magnet.map" -o .\build\stm32f103ve_uart_magnet.axf