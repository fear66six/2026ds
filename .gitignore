# Generated document-search cache
/.cache/

# Local AI/editor coordination metadata (project policy is documented publicly)
/AGENTS.md
/.cursor/
/.cursorignore
/.agents/
/.codex/
/typescript

# Runtime outputs and local diagnostics (selected public samples live in assets/)
/output/
/reports/
/logs/
/tmp/
/backup/
/2026E/output/
/2026E/runs/

# Embedded build reports are machine-specific and may expose local tool paths
/firmware/**/build/

# Pure third-party ARM/ST support sources; obtain from the matching vendor pack
/firmware/*/cmsis/
/firmware/*/startup/

# External reference tree: never commit; treat as immutable (read-only)
/pintu/

# Local snapshot / reference tree (not part of active 2026E)
/2026E-7.31/

# Local Q2 workspace (not tracked with this repo)
/q2/

# Local vendor/reference archive (large, immutable, and redistributability varies)
/docs/**
!/docs/README.md
!/docs/PROJECT_FACTS.md
!/docs/DECISIONS.md
!/docs/TODO_VERIFY.md
!/docs/ARCHITECTURE.md
!/docs/PORTFOLIO.md
!/docs/DEVELOPMENT.md
!/docs/OPEN_SOURCE_CHECKLIST.md
!/docs/interfaces/
!/docs/interfaces/k230_ttl_camera/
!/docs/interfaces/k230_ttl_camera/*.md
!/docs/interfaces/magnet_control/
!/docs/interfaces/magnet_control/*.md
!/docs/q1/
!/docs/q1/*.md

# Python caches and local environments
**/__pycache__/
*.py[cod]
.venv/
venv/
.coverage
coverage.xml
htmlcov/
junit/
.mypy_cache/
.ruff_cache/
.tox/

